#!/usr/bin/env bash
# git-guard-prepare — write a commit message to a stable temp path and emit a
# single-line `git commit -F <path> -- <paths>` command for the user to run.
#
# Part of vdm-git:guard. Exposed via the plugin's bin/ directory, which the
# Claude Code / Qwen Code harnesses add to PATH automatically.
#
# Usage:
#   git-guard-prepare "<commit message>"
#   git-guard-prepare "<commit message>" -- <path>...
#   echo "<message>" | git-guard-prepare -
#   echo "<message>" | git-guard-prepare - -- <path>...
#   git-guard-prepare --verify-last          # audit the previous prep only
#   git-guard-prepare --supersede "<commit message>" [-- <path>...]
#                                            # replace a line still waiting
#
# Output (stdout):
#   <single-line shell command>           # the user copy-pastes this
#
# Why the pathspec is there
#   The index is shared per-repository, but the command is emitted by the
#   assistant and run by the human some time later. With several sessions or
#   agents working the same repo, a neighbour can stage its own files in that
#   gap — and a bare `git commit -F <msg>` would sweep them in. The explicit
#   pathspec makes the emitted command self-contained: what it commits is
#   decided when it is written, not when it is run.
#
# The cost, and why this script refuses instead of degrading
#   `git commit -- <paths>` commits the WORKING TREE version of those paths,
#   not the staged one — and the staged version is then gone, not left behind
#   in the index. For a `git add -p` partial stage that is silent data loss.
#   So when index and worktree diverge on the listed paths, this script exits
#   1 rather than emitting either form: emitting the pathspec form would lose
#   the staged hunks, and falling back to the bare form would resurrect the
#   very defect the pathspec exists to fix. Both degradations are silent; the
#   refusal is loud and is fixed by one `git add`.
#
# Verifying the previous commit (the detector)
#   Each prep records what it INTENDED to commit. On the next run — and on
#   demand via --verify-last — the helper compares that intent against what the
#   commit actually contains, and complains on stderr if they differ.
#
#   This exists because a commit once lost six files and gained one that was
#   never named, and nothing noticed for two days. Three hypotheses about the
#   cause were raised and all three were refuted; the cause is still unknown.
#   A detector needs no theory of the cause, which is exactly why it is the
#   right answer to a defect that resists diagnosis.
#
#   It is deliberately NOT a git hook. A measurement across 12 repositories
#   found git hooks wired in exactly one of them, so a check that lives in a
#   `post-commit` hook is a check that never runs. Living inside the helper,
#   it runs wherever the helper runs, with nothing to install.
#
# Side effects — one trio of sidecars per prep, and only ever one per scope:
#     <scope>/<repo>-<branch>-commit-<token>.txt     the message
#     <scope>/<repo>-<branch>-commit-<token>.paths   NUL-separated intent
#     <scope>/<repo>-<branch>-commit-<token>.meta    the HEAD prepped against
#     <scope>/<repo>-<branch>-commit-<token>.dels    NUL-separated untrackings (only when there are any)
#     <scope>/<repo>-<branch>-commit-<token>.blobs   "<path>\t<staged blob>" per path, NUL-separated
#
# One form without a pathspec. A path untracked with `git rm --cached` and still
#   on disk cannot be committed by pathspec: git takes the listed path from the
#   working tree and commits the file back. Such a prep prints `git commit -F
#   <msg>` with no paths — and only when the index holds nothing but this prep's
#   paths; otherwise it refuses. The detector then checks the untracking landed.
#
#   <scope> is ${TMPDIR:-/tmp}/vdm-git-<uid>/<session> when the harness names its
#   session (CLAUDE_CODE_SESSION_ID), and ${TMPDIR:-/tmp} itself otherwise — a
#   human at a terminal, or a harness that exports no session id.
#
#   `<token>` is minted per prep and never reused, and every prep first DELETES
#   the trio of any earlier prep in the same scope for the same repo and branch.
#   Both halves are load-bearing; neither alone closes the class:
#
#     - Reusable names let a line still sitting in the terminal scrollback be
#       re-pointed at a newer message. It stays runnable and commits the wrong
#       thing, silently.
#     - Unique names alone leave every superseded line runnable forever. That is
#       the reported incident: a line was prepared, the message was then revised,
#       a second line was prepared, and the first — still perfectly valid — was
#       the one that ran, carrying the previous message.
#
#   With both, a superseded line dies on `No such file or directory`. A visible
#   failure beats a quiet commit nobody re-reads.
#
#   Why the scope is a session and not the branch. Until 2026-09-24 it was the
#   branch, and the cost was named in this header: two sessions on one repo and
#   branch annul each other's pending line. Field case (executor, 2026-09-12)
#   showed what that costs where parallel sessions on trunk are the norm rather
#   than an edge: session B's prep deleted A's pending line three times in an
#   hour, A's user found out from git's `could not read log file` after pasting,
#   and the "never run" warning went to B — the one human with nothing to do.
#   A line lives in ONE session's scrollback, so that session is the unit that
#   supersedes it. Within a session nothing changed.
#
#   Why not $PPID as the fallback id. The helper's parent is the shell of one
#   tool call, and every call gets a fresh one — measured: the same session saw
#   a different $PPID on each call. Keying on it would make every prep its own
#   scope, and superseding would silently stop. Without a session id the old
#   per-branch scope is the honest fallback.
#
# A line that is still waiting
#   Superseding kills the earlier line, and for a while that was all a second
#   prep did — after it, a notice said the earlier line "was never run". Two
#   field cases showed what that costs: a session interviewing the owner
#   prepared four lines for one batch, none run (executor, 2026-10-03); another
#   prepared about sixteen, seven run, each extra one after a note added to a
#   crystal — two of them while the owner was still sending a letter
#   (echelon, 2026-10-06). An unrun line usually means the user is not done,
#   not that the line is wrong. And the notice came after the deletion: it
#   could report a dead line, never prevent one.
#
#   So a prep that finds a line of this scope still waiting refuses, deletes
#   nothing, and says when and what was prepared. Edits to the paths that line
#   names ride with it anyway — a pathspec commit takes them from the working
#   tree. `--supersede` is the deliberate exception: the line failed when the
#   user ran it (after a pre-commit refusal nothing on disk tells — the hook
#   runs before git writes anything), or the block changed in substance. Which of those happened is in
#   the conversation, not in the repository, so the flag is the caller's word.
#
# Exit codes:
#   0 success
#   1 missing message / not a git repo / write failed / nothing staged /
#     index-vs-worktree divergence on the listed paths /
#     a line of this scope still waiting (without --supersede)
#
# @see plugins/vdm-git/skills/guard/SKILL.md
# @see docs/tasks/git-guard-explicit-file-list/workitem.md — DL #4, #5, #6
# @see docs/tasks/git-guard-prepare-churn/workitem.md — DL #3

set -eu

# Above this many paths, the inline `-- 'a' 'b' ...` form becomes unreadable
# and awkward to paste, so switch to --pathspec-from-file.
PATHSPEC_INLINE_MAX=${GIT_GUARD_PATHSPEC_INLINE_MAX:-20}

# ------------------------------------------------------------ sidecar files
#
# rm_trio <stem> — retire one prep completely.
#
# All three go together or none do. Removing only `.meta` (which is all the
# audit needs) leaves `.txt` on disk, and a message file on disk is a command
# line that still runs — the whole defect this file now guards against.
rm_trio() { rm -f "$1.txt" "$1.paths" "$1.meta" "$1.dels" "$1.blobs"; }

# session_scope <tmpdir> — the directory this caller's trios live in.
#
# The id is sanitised the way the branch is: it comes from the environment and
# ends up in a path, so nothing in it may climb out of TMPDIR. The uid keeps
# users apart on a shared /tmp, where a directory made by one user cannot be
# written by another.
session_scope() {
  local tmpdir="$1" session
  session=$(printf '%s' "${CLAUDE_CODE_SESSION_ID:-}" \
    | sed -e 's|[^A-Za-z0-9_-]|-|g' -e 's|-\{2,\}|-|g' -e 's|^-||' -e 's|-$||' \
    | cut -c1-64)
  if [ -n "$session" ]; then
    printf '%s/vdm-git-%s/%s' "$tmpdir" "$(id -u)" "$session"
  else
    printf '%s' "$tmpdir"
  fi
}

# norm_msg — the form in which a prepared message and a commit message are
# compared. `git commit -F` cleans a message up (trailing whitespace, leading
# and repeated blank lines), so both sides get the same treatment.
norm_msg() { sed -e 's/[[:space:]]*$//' | cat -s | sed -e '/./,$!d'; }

# prep_state <stem> <head> — what became of one prep. Prints one of:
#   pending         no commit carries its message yet: the line is unrun
#   consumed <sha>  <sha> is the commit its line produced
#   unknown         cannot say — the record is incomplete, or history was
#                   rewritten since (amend, rebase onto something else, reset)
#
# "HEAD moved" is NOT "consumed". It used to be, and in a single session that
# was nearly true; with a neighbour committing on the same branch it is false
# both ways: a neighbour's commit made an unrun line look consumed (swept
# without a word), and our own commit landing on top of the neighbour's was not
# recognised as ours (never audited). So the prep's own commit is found by its
# message, among the commits made on top of the prep's HEAD.
prep_state() {
  local stem="$1" head="$2" recorded want rec sha body
  if [ ! -f "$stem.meta" ] || [ ! -f "$stem.txt" ] || [ ! -f "$stem.paths" ]; then
    echo unknown; return 0
  fi
  recorded=$(cat "$stem.meta" 2>/dev/null || echo "")
  [ "$recorded" = "$head" ] && { echo pending; return 0; }
  [ -n "$recorded" ] || { echo unknown; return 0; }
  git merge-base --is-ancestor "$recorded" HEAD 2>/dev/null || { echo unknown; return 0; }

  want=$(norm_msg < "$stem.txt")
  while IFS= read -r -d '' rec; do
    sha=${rec%%$'\n'*}
    body=${rec#*$'\n'}
    if [ "$(printf '%s' "$body" | norm_msg)" = "$want" ]; then
      echo "consumed $sha"; return 0
    fi
  done < <(git log -z --ancestry-path --max-count=200 --format='%H%n%B' \
             "$recorded..HEAD" 2>/dev/null || true)
  echo pending
}

# sweep_superseded <dir> <base> <head>
#
# Every prep begins by clearing the field. Whatever sidecars survived the audit
# belong to preps this one replaces, and each surviving `.txt` is a runnable
# command carrying a message that is no longer the current one.
#
# A prep still `pending` was never committed, so its line is outstanding in
# this session's scrollback and the caller has to be told. Anything else was
# already audited by verify_last, cannot be traced, or predates this scheme
# entirely — which is how a machine accumulated nineteen live message files —
# and is swept without comment.
sweep_superseded() {
  local dir="$1" base="$2" head="$3"
  local f stem pending=0

  for f in "$dir/$base"*.txt; do
    [ -f "$f" ] || continue
    stem="${f%.txt}"
    [ "$(prep_state "$stem" "$head")" = pending ] && pending=$((pending + 1))
    rm_trio "$stem"
  done

  # Leftover from the pre-token scheme, which kept one shared sentinel per base.
  rm -f "$dir/.$base.head"

  [ "$pending" -eq 0 ] && return 0
  {
    echo "git-guard-prepare: ⚠ a prepared command for this branch was never run (pending: $pending)."
    echo "                   Its message file is deleted, so that line is now dead — running it"
    echo "                   fails instead of committing a stale message."
    echo "                   Hand off the line below, and say the earlier one is void."
  } >&2
  return 0
}

# waiting_line <dir> <base> <head> — the prep in this scope whose line has not
# been run, as "<epoch>\t<subject>"; nothing when there is none.
#
# Asked BEFORE anything is deleted. sweep_superseded reports an unrun line only
# after it has killed it, so its notice can tell the caller that a line died
# but never stop it from dying — see "A line that is still waiting" above.
waiting_line() {
  local dir="$1" base="$2" head="$3" f stem tok epoch
  for f in "$dir/$base"*.txt; do
    [ -f "$f" ] || continue
    stem="${f%.txt}"
    [ "$(prep_state "$stem" "$head")" = pending ] || continue
    tok="${stem##*/}"; tok="${tok#"$base"-}"; epoch="${tok%%-*}"
    case "$epoch" in ''|*[!0-9]*) epoch="" ;; esac
    printf '%s\t%s\n' "$epoch" "$(head -n 1 "$f")"
    return 0
  done
  return 0
}

# mint_stem <tmpdir> <base>
#
# A stem is never reused. Reuse is the half of the defect the sweep above does
# not cover: delete a file and its name becomes free again, and the next prep
# taking that name silently re-points an old scrollback line at a new message.
#
# Seconds + PID cannot collide within one process — a process preps at most
# once — and the existence loop covers a clock that moves backwards.
mint_stem() {
  local tmpdir="$1" base="$2"
  local root="${tmpdir}/${base}-$(date +%s)-$$"
  local stem="$root" n=2
  while [ -e "$stem.txt" ] || [ -e "$stem.paths" ] || [ -e "$stem.meta" ]; do
    stem="${root}-${n}"
    n=$((n + 1))
  done
  printf '%s' "$stem"
}

# ---------------------------------------------------------------- detector
#
# verify_last <dir> <base>
#
# Each prep leaves three sidecars: `<name>.txt` (the message), `<name>.paths`
# (NUL-separated intended paths) and `<name>.meta` (the HEAD it was prepared
# against). If a commit made on top of that HEAD carries the prep's message, the
# commit came from that prep (prep_state) — so compare what it actually touched
# against what was intended. A neighbour's commit in between is neither mistaken
# for ours nor allowed to hide ours.
#
# Leaves counts behind for --verify-last's summary: verify_clean,
# verify_dirty, verify_pending, verify_unknown, and the last audited sha.
#
# Two directions, and they are not symmetric:
#   EXTRA   — in the commit, never named. Always wrong. Something else wrote to
#             the index or the tree between prep and commit.
#   MISSING — named, absent from the commit. Usually wrong, but a named path
#             whose content already equalled HEAD legitimately produces no diff
#             entry, so it is reported as a warning rather than an error —
#             EXCEPT when the commit is empty, which is never legitimate.
#
# Fail-open everywhere: an unreadable sidecar, a rebase, a squash, anything
# unexpected — say nothing. A detector that cries wolf on ordinary git usage
# gets ignored, and then it is worse than absent.
verify_clean=0 verify_dirty=0 verify_pending=0 verify_unknown=0 verify_sha=""

verify_last() {
  local dir="$1" base="$2"
  local meta stem state sha head

  head=$(git rev-parse --verify HEAD 2>/dev/null || echo "")

  for meta in "$dir/$base"*.meta; do
    [ -f "$meta" ] || continue
    stem="${meta%.meta}"
    state=$(prep_state "$stem" "$head")
    case "$state" in
      pending)
        # Its line has not run. Leave it for the sweep, which says so.
        verify_pending=$((verify_pending + 1)) ;;
      consumed\ *)
        sha=${state#consumed }
        verify_sha=$sha
        if _verify_one "$stem.paths" "$sha^" "$sha" "$stem.dels" "$stem"; then
          verify_clean=$((verify_clean + 1))
        else
          verify_dirty=$((verify_dirty + 1))
        fi
        rm_trio "$stem" ;;
      *)
        # Amend, rebase onto something else, reset, a half-written record — not
        # this detector's business. Drop the record so it is not re-examined.
        verify_unknown=$((verify_unknown + 1))
        rm_trio "$stem" ;;
    esac
  done
  return 0
}

_verify_one() {
  local pathsf="$1" parent="$2" head="$3" delsf="${4:-}" stem="${5:-}"
  local intended=() actual=() extra=() missing=() kept=() changed=() p st

  while IFS= read -r -d '' p; do intended+=("$p"); done < "$pathsf"
  [ ${#intended[@]} -eq 0 ] && return 0

  while IFS= read -r -d '' p; do actual+=("$p"); done \
    < <(git diff-tree --no-commit-id -r -z --name-only --no-renames "$parent" "$head" 2>/dev/null)

  local i a hit
  for a in ${actual[@]+"${actual[@]}"}; do
    hit=0
    for i in "${intended[@]}"; do [ "$a" = "$i" ] && { hit=1; break; }; done
    [ "$hit" -eq 0 ] && extra+=("$a")
  done
  for i in "${intended[@]}"; do
    hit=0
    for a in ${actual[@]+"${actual[@]}"}; do [ "$i" = "$a" ] && { hit=1; break; }; done
    [ "$hit" -eq 0 ] && missing+=("$i")
  done

  # An untracking the prep meant to commit must show as a deletion. A path
  # staged back in between commits as a change, and the name list above
  # cannot tell the two apart.
  if [ -n "$delsf" ] && [ -f "$delsf" ]; then
    while IFS= read -r -d '' p; do
      st=""
      IFS= read -r -d '' st < <(git diff-tree --no-commit-id -r -z --name-status --no-renames "$parent" "$head" -- "$p" 2>/dev/null) || true
      [ "$st" = "D" ] || kept+=("$p")
    done < "$delsf"
  fi

  # The content, not only the names. A pathspec line takes its paths from disk
  # when it RUNS. Run late — after another session committed (HEAD moved) and
  # rewrote the same files — it commits that work under this prep's message,
  # and the names still match (this repository, 2026-10-05: seven files, one
  # evening's line run the next night). So the staged blob of each path at prep
  # is compared with the commit's — but only when HEAD moved in between. With
  # HEAD unchanged a different blob is what a formatting pre-commit hook
  # produces, and a warning on every commit of such a project is a warning
  # nobody reads.
  local recorded=""
  [ -n "$stem" ] && [ -f "$stem.meta" ] && recorded=$(cat "$stem.meta" 2>/dev/null || echo "")
  if [ -n "$stem" ] && [ -f "$stem.blobs" ] && [ -n "$recorded" ] \
     && [ "$(git rev-parse --verify -q "$parent" 2>/dev/null)" != "$recorded" ]; then
    local top rec want got
    top=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
    while IFS= read -r -d '' rec; do
      p="${rec%%$'\t'*}"; want="${rec#*$'\t'}"
      got=""
      IFS= read -r -d '' got < <(git -C "$top" ls-tree -z "$head" -- "$p" 2>/dev/null) || true
      got="${got%%$'\t'*}"; got="${got##* }"         # "<mode> blob <id>\t<path>" → <id>
      [ -n "$want" ] && [ "$got" != "$want" ] && changed+=("$p")
    done < "$stem.blobs"
  fi

  [ ${#extra[@]} -eq 0 ] && [ ${#missing[@]} -eq 0 ] && [ ${#kept[@]} -eq 0 ] && [ ${#changed[@]} -eq 0 ] && return 0

  {
    echo "git-guard-prepare: ⚠ the commit made from the previous prepared command does not match what was prepared."
    echo "                   commit $(git rev-parse --short "$head")"
    if [ ${#extra[@]} -gt 0 ]; then
      echo
      echo "  SWEPT IN — in the commit, never named by the prepared command:"
      for p in "${extra[@]}"; do echo "      $p"; done
    fi
    if [ ${#missing[@]} -gt 0 ]; then
      echo
      if [ ${#actual[@]} -eq 0 ]; then
        echo "  EMPTY COMMIT — nothing was committed, though ${#intended[@]} path(s) were named:"
      else
        echo "  NOT COMMITTED — named by the prepared command, absent from the commit"
        echo "  (a named path whose content already matched HEAD is legitimate here):"
      fi
      for p in "${missing[@]}"; do echo "      $p"; done
    fi
    if [ ${#changed[@]} -gt 0 ]; then
      echo
      echo "  CHANGED SINCE PREP — committed with other content than was staged when the line was prepared:"
      for p in "${changed[@]}"; do echo "      $p"; done
      echo "  The line was prepared on $(git rev-parse --short "$recorded" 2>/dev/null) and ran on $(git rev-parse --short "$parent" 2>/dev/null):"
      echo "  a pathspec line takes its paths from disk when it runs, so what rewrote them in between went in"
      echo "  under this message. Your own edits made after the prep ride along by design; another session's"
      echo "  work does not."
    fi
    if [ ${#kept[@]} -gt 0 ]; then
      echo
      echo "  NOT UNTRACKED — prepared to leave git (\`git rm --cached\`), still tracked after the commit:"
      for p in "${kept[@]}"; do echo "      $p"; done
    fi
    echo
    echo "  Something changed the index or the tree between prepare and commit."
    echo "  Check the commit before building on it: git show --stat $(git rev-parse --short "$head")"
  } >&2
  return 1
}

usage() {
  cat >&2 <<'USAGE'
Usage: git-guard-prepare "<commit message>" [-- <path>...]
       echo "<message>" | git-guard-prepare - [-- <path>...]
       git-guard-prepare --supersede "<commit message>" [-- <path>...]
       git-guard-prepare --verify-last

Writes the message to a per-prep file under ${TMPDIR:-/tmp} and prints a
single-line `git commit -F <path> -- <paths>` command for the user to run.

While a prepared line has not been run, preparing again refuses and deletes
nothing: the user may not be done. With --supersede the earlier line's message
file is deleted, so that line fails instead of committing a message that has
moved on. The scope is this session (CLAUDE_CODE_SESSION_ID) on this repo and
branch; without a session id, the repo and branch. A neighbouring session's
line is never touched.

Paths come from the explicit `--` list when given, otherwise from a snapshot
of the index at prep time. Exits 1 if the index is empty, or if the working
tree differs from the index on any of those paths.

Every prep records its intended path list. The next prep — or --verify-last —
compares that intent against what the commit actually contains and reports any
path that was swept in or dropped.
USAGE
}

if [ $# -lt 1 ]; then
  usage
  exit 1
fi

if [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
  usage
  exit 0
fi

# --verify-last audits the previous prep and exits; it prepares nothing. Useful
# from a post-commit hook, or by hand after a commit that looks wrong.
if [ "$1" = "--verify-last" ]; then
  vr_root=$(git rev-parse --show-toplevel 2>/dev/null || true)
  [ -z "$vr_root" ] && { echo "git-guard-prepare: not inside a git repository" >&2; exit 1; }
  vr_branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null \
    || git rev-parse --short HEAD 2>/dev/null || echo detached)
  vr_branch=$(printf '%s' "$vr_branch" \
    | sed -e 's|[^A-Za-z0-9_-]|-|g' -e 's|-\{2,\}|-|g' -e 's|^-||' -e 's|-$||')
  [ -z "$vr_branch" ] && vr_branch=detached
  vr_tmp="${TMPDIR:-/tmp}"; vr_tmp="${vr_tmp%/}"
  verify_last "$(session_scope "$vr_tmp")" "$(basename "$vr_root")-${vr_branch}-commit"

  # Asked for by name, so every outcome is stated — silence would read the same
  # whether the commit matched, whether nothing of ours was there to check, and
  # whether the check never ran. A mismatch has already been reported on stderr;
  # the rest goes to stdout, so a post-commit hook can still `>/dev/null` it.
  if [ -n "${CLAUDE_CODE_SESSION_ID:-}" ]; then vr_scope="this session"; else vr_scope="this branch"; fi
  if [ "$verify_dirty" -gt 0 ]; then
    :
  elif [ "$verify_clean" -gt 0 ]; then
    echo "git-guard-prepare: ✓ $(git rev-parse --short "$verify_sha") matches what was prepared."
  elif [ "$verify_pending" -gt 0 ]; then
    echo "git-guard-prepare: nothing to verify — the prepared command has not been committed yet"
    echo "                   (no commit since the prep carries its message)."
  elif [ "$verify_unknown" -gt 0 ]; then
    echo "git-guard-prepare: nothing to verify — history was rewritten since the prep"
    echo "                   (amend, rebase or reset), so its commit cannot be traced."
  else
    echo "git-guard-prepare: nothing to verify — no prepared command on record for $vr_scope."
  fi
  exit 0
fi

# --supersede: replace a line of this session that is still waiting to be run.
# Accepted before the message or right after it.
supersede=0
if [ "$1" = "--supersede" ]; then
  supersede=1
  shift
  [ $# -ge 1 ] || { usage; exit 1; }
fi

if [ "$1" = "-" ]; then
  message=$(cat)
else
  message="$1"
fi
shift

if [ $# -gt 0 ] && [ "$1" = "--supersede" ]; then
  supersede=1
  shift
fi

# Remaining args, if any, must start with `--` and are the explicit path list.
explicit_paths=()
if [ $# -gt 0 ]; then
  if [ "$1" != "--" ]; then
    echo "git-guard-prepare: unexpected argument '$1' (expected '--' before paths)" >&2
    usage
    exit 1
  fi
  shift
  explicit_paths=("$@")
fi

if [ -z "${message//[[:space:]]/}" ]; then
  echo "git-guard-prepare: empty commit message" >&2
  exit 1
fi

repo_root=$(git rev-parse --show-toplevel 2>/dev/null || true)
if [ -z "$repo_root" ]; then
  echo "git-guard-prepare: not inside a git repository" >&2
  exit 1
fi
repo_name=$(basename "$repo_root")

branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null \
  || git rev-parse --short HEAD 2>/dev/null \
  || echo detached)

# Sanitize branch for use in a filename: any non-alphanumeric (besides `_`) →
# `-`, collapse runs, trim ends. Catches /, :, .., ~, spaces, etc.
branch_safe=$(printf '%s' "$branch" \
  | sed -e 's|[^A-Za-z0-9_-]|-|g' -e 's|-\{2,\}|-|g' -e 's|^-||' -e 's|-$||')
[ -z "$branch_safe" ] && branch_safe=detached

# ------------------------------------------------ Syncthing conflict copies
# Syncthing syncs working folders together with .git, and one repo is worked
# from two machines at once (owner's decision, vdx DL #17, 2026-09-30). When
# both machines write one file in .git, Syncthing keeps one version and lays
# the other beside it as `*.sync-conflict-*`. Nobody sees it: a copy of a
# branch ref can hold a commit that dropped out of the branch (hq,
# 11.09), a copy of the index means the live index lost an update (vdx, 30.09).
# A new commit on top of a dropped one is the harm, and this is the last moment
# before it — so the prep refuses and names each copy. objects/ is not walked:
# objects are immutable, and walking thousands of them would tax every prep.
sync_dirs=$(git rev-parse --absolute-git-dir 2>/dev/null || true)
sync_common=$(git rev-parse --git-common-dir 2>/dev/null || true)
if [ -n "$sync_common" ]; then
  case "$sync_common" in
    /*) ;;
    *)  sync_common=$(cd "$sync_common" 2>/dev/null && pwd -P || true) ;;
  esac
fi
sync_found=""
for gd in "$sync_common" "$sync_dirs"; do
  [ -n "$gd" ] && [ -d "$gd" ] || continue
  hits=$(find "$gd" -path "$gd/objects" -prune -o -name '*.sync-conflict-*' -print 2>/dev/null)
  [ -n "$hits" ] && sync_found="$sync_found$hits
"
done
sync_found=$(printf '%s' "$sync_found" | sed '/^$/d' | sort -u)

# --------------------------------------- HEAD's commit not delivered yet
# Syncthing carries .git file by file, so a commit made on the other machine
# can land as its branch ref first and as its object later — executor,
# 2026-10-01: about fifteen minutes. In between HEAD names a commit this
# repository does not have: `git log` says "bad object HEAD", `git show-ref`
# calls the ref bad, and a prep would hand out a commit line on top of a parent
# it cannot read. Nothing can be judged until the object is here — not even the
# conflict copies found above, whose verdict needs the branch's history — so
# this is decided before they are listed. `rev-parse --verify` resolves the ref
# without looking for its object, which is exactly the distinction needed; an
# unborn branch resolves to nothing and passes.
head_lag=$(git rev-parse --verify -q HEAD 2>/dev/null || true)
if [ -n "$head_lag" ] && ! git cat-file -e "$head_lag^{commit}" 2>/dev/null; then
  lag_copies=$(printf '%s\n' "$sync_found" | grep -c . || true)
  {
    echo "git-guard-prepare: ✗ $branch points to commit ${head_lag:0:7}, which is not in this repository yet — nothing prepared."
    echo "  On a .git that Syncthing carries between machines, a branch ref can arrive before its"
    echo "  commit does. The branch is not gone and nothing is lost: wait until"
    echo "      git cat-file -e $head_lag"
    echo "  succeeds, then run git-guard-prepare again."
    if [ "${lag_copies:-0}" -gt 0 ]; then
      if [ "$lag_copies" -eq 1 ]; then lag_what="1 Syncthing conflict copy also lies"
      else lag_what="$lag_copies Syncthing conflict copies also lie"; fi
      echo "  $lag_what in .git; once the branch's history can be read, the"
      echo "  next run names each one with what to do."
    fi
  } >&2
  exit 1
fi

if [ -n "$sync_found" ]; then
  base="${sync_common:-$sync_dirs}"
  {
    echo "git-guard-prepare: ✗ Syncthing conflict copies inside .git — nothing prepared."
    echo "  Two machines wrote the same file in .git; one version stayed, the other lies beside it:"
    printf '%s\n' "$sync_found" | while IFS= read -r copy; do
      [ -n "$copy" ] || continue
      rel="${copy#"$base"/}"
      echo "  • $rel"
      case "$rel" in
        refs/heads/*.sync-conflict-*)
          ref_branch="${rel#refs/heads/}"; ref_branch="${ref_branch%%.sync-conflict-*}"
          sha=$(head -n 1 "$copy" 2>/dev/null | tr -d '[:space:]')
          if [ -n "$sha" ] && git cat-file -e "$sha^{commit}" 2>/dev/null; then
            short=$(git rev-parse --short "$sha")
            subject=$(git log -1 --format=%s "$sha" 2>/dev/null)
            # Existence by `rev-parse --verify`, not `show-ref --verify`: the
            # latter also fails — loudly, past --quiet — on a branch whose own
            # commit has not arrived yet, and that is not a branch that is gone.
            live=$(git rev-parse --verify -q "refs/heads/$ref_branch" 2>/dev/null || true)
            if [ -z "$live" ]; then
              echo "      → commit $short \"$subject\" — branch $ref_branch no longer exists; recover it: git branch <name> $short, then delete the copy"
            elif ! git cat-file -e "$live^{commit}" 2>/dev/null; then
              echo "      → commit $short \"$subject\" — branch $ref_branch points to ${live:0:7}, which has not arrived yet:"
              echo "          wait until \`git cat-file -e $live\` succeeds and run again; only then can this copy be judged"
            elif git merge-base --is-ancestor "$sha" "refs/heads/$ref_branch" 2>/dev/null; then
              echo "      → commit $short \"$subject\" — in $ref_branch: nothing lost; delete the copy"
            else
              echo "      → commit $short \"$subject\" — not in $ref_branch: a dropped commit. Bring it back before a new one lands on top:"
              echo "          git cherry-pick $short   (or git merge $short), then delete the copy"
            fi
          else
            echo "      → holds no commit this repository knows; compare it with refs/heads/$ref_branch, then delete it"
          fi
          ;;
        index.sync-conflict-*|worktrees/*/index.sync-conflict-*)
          echo "      → a copy of the index: the live index may have lost an update. Compare \`git status\` with what"
          echo "        you staged, \`git reset -- <path>\` an entry that should not be there, then delete the copy"
          ;;
        *)
          echo "      → compare it with ${rel%%.sync-conflict-*}, keep the right version, then delete the copy"
          ;;
      esac
    done
    echo "  Then run git-guard-prepare again."
  } >&2
  exit 1
fi

# ------------------------------------------------- a line still waiting
#
# Decided before any other check: when a line is waiting, the answer is "hand
# off nothing new" whatever the index looks like now. See the header.
if [ "$supersede" -eq 0 ]; then
  wl_tmp="${TMPDIR:-/tmp}"; wl_tmp="${wl_tmp%/}"
  waiting=$(waiting_line "$(session_scope "$wl_tmp")" "${repo_name}-${branch_safe}-commit" \
              "$(git rev-parse --verify -q HEAD 2>/dev/null || true)")
  if [ -n "$waiting" ]; then
    wl_epoch="${waiting%%$'\t'*}"; wl_subject="${waiting#*$'\t'}"
    wl_when=""
    if [ -n "$wl_epoch" ]; then
      wl_clock=$(date -r "$wl_epoch" '+%H:%M' 2>/dev/null || date -d "@$wl_epoch" '+%H:%M' 2>/dev/null || true)
      wl_min=$(( ($(date +%s) - wl_epoch) / 60 ))
      wl_when=" — prepared ${wl_clock:-earlier}, $wl_min min ago"
    fi
    {
      echo "git-guard-prepare: a line for this branch is still waiting to be run$wl_when:"
      echo "                     $wl_subject"
      echo "                   Nothing was deleted: that line still runs as handed off."
      echo
      echo "  A line is handed off once per finished block. While it waits, the user may still be"
      echo "  discussing the work, or busy with a step of their own — a letter to send, a reply to"
      echo "  wait for. Edits to the paths it names ride with it (a pathspec commit takes them from"
      echo "  the working tree); new files go with the next commit. So hand off nothing new."
      echo
      echo "  Prepare again only if the user reported that line failed, or the block changed in"
      echo "  substance — its message is no longer true, or a file joins it:"
      echo "      git-guard-prepare --supersede \"<message>\" [-- <path>...]"
      echo "  The earlier line then dies; say so when you hand off the new one."
    } >&2
    exit 1
  fi
fi

# ---------------------------------------------------------------- path list
#
# Explicit `-- <paths>` wins; otherwise snapshot the index.
#
# `--no-renames` is load-bearing, not decoration. Git detects `git mv` as a
# rename (R100) and `--name-only` then reports only the DESTINATION path. A
# commit built from that list records the addition without the deletion, so
# the old path survives in the commit tree — the exact corruption this list is
# meant to prevent. `--no-renames` splits the pair back into A + D, giving
# both sides. `-z` is likewise required: without it git C-quotes non-ASCII
# paths ("gaps/\320\272...") and separates on newlines, which a path may
# legally contain.

paths=()
if [ ${#explicit_paths[@]} -gt 0 ]; then
  paths=("${explicit_paths[@]}")
else
  while IFS= read -r -d '' p; do
    paths+=("$p")
  done < <(git diff --cached --name-only -z --no-renames)
fi

if [ ${#paths[@]} -eq 0 ]; then
  echo "git-guard-prepare: nothing staged — run 'git add <file>...' first," >&2
  echo "                   or pass an explicit list: git-guard-prepare \"<msg>\" -- <path>..." >&2
  exit 1
fi

# What the listed paths are relative to. A snapshot of the index names paths
# from the top of the work tree whatever the caller's cwd; explicit paths are
# the caller's own and name them from where the caller stands. Every check
# below reads from this base. Reading snapshot paths from the cwd instead was a
# silent hole: run from a subdirectory, `sub/x.md` resolved to `sub/sub/x.md`,
# the U+FFFD check found no file and passed, and so did the check below.
if [ ${#explicit_paths[@]} -gt 0 ]; then
  path_base=$(pwd)
  relative_flag=(--relative)
else
  path_base="$repo_root"
  relative_flag=()
fi

path_file() {
  case "$1" in
    /*) printf '%s' "$1" ;;
    *)  printf '%s/%s' "$path_base" "$1" ;;
  esac
}

# ------------------------------------------------- index vs worktree check
#
# `git commit -- <paths>` takes the working-tree content of those paths. If it
# differs from what is staged, the emitted command would commit something the
# caller never staged — and would destroy the staged version in the process.
# Refuse; see the header comment for why neither degradation is acceptable.

divergent=()
while IFS= read -r -d '' p; do
  divergent+=("$p")
done < <(git -C "$path_base" diff --name-only -z --no-renames -- "${paths[@]}")

if [ ${#divergent[@]} -gt 0 ]; then
  {
    echo "git-guard-prepare: working tree differs from the index on:"
    for p in "${divergent[@]}"; do
      echo "                     $p"
    done
    echo
    echo "  A pathspec commit would take the WORKING TREE version of these paths"
    echo "  and discard what is staged — including hunks chosen via 'git add -p'."
    echo
    echo "  Fix by reconciling, then re-run:"
    echo "    git add <path>...        # accept the working-tree version, or"
    echo "    git checkout -- <path>   # discard it and keep what is staged"
    echo
    echo "  Or name exactly what to commit:"
    echo "    git-guard-prepare \"<msg>\" -- <path>..."
  } >&2
  exit 1
fi

# ------------------------------------------- untracking (`git rm --cached`)
#
# Field case (executor, 2026-10-04): a directory went into .gitignore, four
# tracked files were `git rm --cached`, and the prepared pathspec commit put all
# four back — as modifications. For a listed path `git commit -- <paths>` takes
# the working tree, the file was there, and the deletion staged in the index was
# dropped without a word. The check above cannot see it: `git diff` lists no
# file the index no longer holds.
#
# Only a commit of the whole index records an untracking, and that form is safe
# exactly when the index holds nothing but this prep's paths — the sweep-in the
# pathspec exists to prevent has nothing to sweep. Anything else staged: refuse,
# because both forms would commit something other than what was prepared.
# A deletion whose file is gone from disk is an ordinary `git rm`; the pathspec
# form commits it correctly and stays.

untracked=()
while IFS= read -r -d '' st && IFS= read -r -d '' p; do
  [ "$st" = "D" ] || continue
  if [ -e "$repo_root/$p" ] || [ -L "$repo_root/$p" ]; then
    untracked+=("$p")
  fi
done < <(git -C "$path_base" diff --cached --name-status -z --no-renames -- "${paths[@]}" 2>/dev/null || true)

whole_index=0
if [ ${#untracked[@]} -gt 0 ]; then
  ours=() others=()
  while IFS= read -r -d '' p; do ours+=("$p"); done \
    < <(git -C "$path_base" diff --cached --name-only -z --no-renames -- "${paths[@]}" 2>/dev/null || true)
  while IFS= read -r -d '' p; do
    hit=0
    for o in ${ours[@]+"${ours[@]}"}; do [ "$p" = "$o" ] && { hit=1; break; }; done
    [ "$hit" -eq 0 ] && others+=("$p")
  done < <(git -C "$repo_root" diff --cached --name-only -z --no-renames 2>/dev/null || true)
  if [ ${#others[@]} -gt 0 ]; then
    {
      echo "git-guard-prepare: untracked with \`git rm --cached\` and still on disk:"
      for p in "${untracked[@]}"; do echo "                     $p"; done
      echo
      echo "  A pathspec commit takes a listed path from the working tree, so it would"
      echo "  commit these files back instead of removing them from git. A commit of"
      echo "  the whole index would record the removal — but would also take what else"
      echo "  is staged and was never named here:"
      for p in "${others[@]}"; do echo "                     $p"; done
      echo
      echo "  If those are part of this commit, prepare without a list:"
      echo "    git-guard-prepare \"<msg>\""
      echo "  If they belong to someone else, commit the untracking after theirs."
    } >&2
    exit 1
  fi
  whole_index=1
  # The record compares against a commit, and a commit names paths from the top
  # of the work tree; every check below then reads them from there.
  paths=(${ours[@]+"${ours[@]}"})
  path_base="$repo_root"
  relative_flag=()
fi

# ----------------------------------------------------------- U+FFFD check
#
# Refuse to prepare a commit whose content carries U+FFFD (the replacement
# character). It is what a truncated multi-byte codepoint decodes to, and a
# batch write across many files is how it arrives: one interrupted Cyrillic
# letter becomes two of these and nothing else changes. Origin incident
# (commit ff78039, 2026-04-24): 21 corruption points across 11 files, noticed
# three weeks later.
#
# Why here and not only in a git hook. The corruption is produced by a batch
# write, and a batch write is followed by a commit the assistant prepares —
# which is this helper. A pre-commit hook covers the other side (a commit made
# by hand or from an IDE), but it has to be installed in every clone, and an
# uninstalled hook is indistinguishable from a clean one. This check has no
# installation step: it works wherever the helper works.
#
# The check is the grep's exit status, so a broken `git diff` cannot turn an
# empty file list into a clean verdict — the paths come from the array already
# validated above.
#
# A file git itself treats as binary (`-` in `--numstat`) is skipped: in a PDF
# the bytes EF BF BD are data, and blocking the attachment teaches the habit of
# going around the gate. If that lookup fails, the list stays empty and every
# file is read — a broken lookup costs a false alarm, never a missed one.

binary=()
while IFS= read -r -d '' entry; do
  case "$entry" in
    -$'\t'-$'\t'*) binary+=("${entry#-$'\t'-$'\t'}") ;;
  esac
done < <(git -C "$path_base" diff --cached --numstat -z --no-renames \
           ${relative_flag[@]+"${relative_flag[@]}"} -- "${paths[@]}" 2>/dev/null || true)

is_binary() {
  local b
  for b in ${binary[@]+"${binary[@]}"}; do
    [ "$b" = "$1" ] && return 0
  done
  return 1
}

corrupt=()
for p in "${paths[@]}"; do
  f=$(path_file "$p")
  [ -f "$f" ] || continue
  is_binary "$p" && continue
  if LC_ALL=C grep -q $'\xef\xbf\xbd' "$f" 2>/dev/null; then
    corrupt+=("$p")
  fi
done

if [ ${#corrupt[@]} -gt 0 ]; then
  {
    echo "git-guard-prepare: U+FFFD (replacement character) in:"
    for p in "${corrupt[@]}"; do
      echo "                     $p"
      LC_ALL=C grep -n $'\xef\xbf\xbd' "$(path_file "$p")" 2>/dev/null | head -3 | sed 's/^/                       /'
    done
    echo
    echo "  That character is what a truncated multi-byte codepoint decodes to —"
    echo "  usually a batch write that cut a Cyrillic letter in half. Committing it"
    echo "  preserves the damage in history, where it is found weeks later."
    echo
    echo "  Restore the missing characters, then re-run. If the character is"
    echo "  genuinely part of the content, commit that file separately with"
    echo "  'git commit --no-verify' after staging it deliberately."
  } >&2
  exit 1
fi

# ------------------------------------------------------------- write files

tmpdir="${TMPDIR:-/tmp}"
tmpdir="${tmpdir%/}"
scope=$(session_scope "$tmpdir")
if ! mkdir -p "$scope" 2>/dev/null; then
  echo "git-guard-prepare: cannot create $scope" >&2
  exit 1
fi

base="${repo_name}-${branch_safe}-commit"

# `--verify` matters: a plain `git rev-parse HEAD` in a repo with an unborn HEAD
# prints the literal string "HEAD" on stdout while exiting non-zero, so the
# `|| echo ""` fallback never gets a chance and head_sha becomes "HEAD" — a
# value that then compares equal to itself forever.
head_sha=$(git rev-parse --verify HEAD 2>/dev/null || echo "")

# Before preparing anything: did the PREVIOUS prep produce the commit it said
# it would? This is the moment someone is paying attention to commits, which is
# why the check lives here rather than in a git hook nobody installs.
verify_last "$scope" "$base" || true

# Then clear the field. Anything the audit left behind belongs to a prep this
# one supersedes, and a superseded message file is a runnable command line.
sweep_superseded "$scope" "$base" "$head_sha"

stem=$(mint_stem "$scope" "$base")
path="${stem}.txt"
paths_file="${stem}.paths"

# Write the message (atomic via temp + rename to avoid torn reads if the user
# is `cat`ing the file in another pane).
tmpfile="${path}.tmp.$$"
printf '%s\n' "$message" > "$tmpfile"
mv -f "$tmpfile" "$path"

# ------------------------------------------------------------------- emit

# Single-quote for the shell; a literal single quote inside a path closes the
# quote, escapes itself, and reopens — the POSIX way.
#
# The substitution must happen in an unquoted assignment. Inlining it into a
# quoted printf argument changes how bash parses the backslashes in the
# replacement and silently produces a mangled escape.
shell_quote() {
  local escaped=${1//\'/\'\\\'\'}
  printf "'%s'" "$escaped"
}

msg_q=$(shell_quote "$path")

# The paths file is written on EVERY prep, not only for long lists: it is both
# the pathspec source for the long form and the record the detector compares
# the resulting commit against. A short prep that kept no record would be a
# blind spot exactly where most commits live.
tmpfile="${paths_file}.tmp.$$"
: > "$tmpfile"
for p in "${paths[@]}"; do
  printf '%s\0' "$p" >> "$tmpfile"
done
mv -f "$tmpfile" "$paths_file"

# The HEAD this prep was made against, alongside its own message and path list.
# Per-prep rather than shared: the detector needs all three of a prep together,
# and it is this file that later tells a superseded prep (recorded HEAD still
# current ⇒ never committed) from a consumed one.
#
# Written last, before the command line is printed. A trio without it is a prep
# that died mid-write: the detector skips it and the next sweep clears it away,
# neither of them guessing at what it meant to commit.
if [ ${#untracked[@]} -gt 0 ]; then
  tmpfile="${stem}.dels.tmp.$$"
  : > "$tmpfile"
  for p in "${untracked[@]}"; do
    printf '%s\0' "$p" >> "$tmpfile"
  done
  mv -f "$tmpfile" "${stem}.dels"
fi

# What each path is committed with — its staged blob now. The detector compares
# it with the commit when HEAD moved between this prep and the line's run.
tmpfile="${stem}.blobs.tmp.$$"
: > "$tmpfile"
while IFS= read -r -d '' rec; do
  meta_part="${rec%%$'\t'*}"; blob="${meta_part#* }"; blob="${blob%% *}"
  printf '%s\t%s\0' "${rec#*$'\t'}" "$blob" >> "$tmpfile"
done < <(git -C "$path_base" ls-files -s -z --full-name -- "${paths[@]}" 2>/dev/null || true)
mv -f "$tmpfile" "${stem}.blobs"

printf '%s\n' "${head_sha:-}" > "${stem}.meta"

if [ "$whole_index" -eq 1 ]; then
  # No pathspec: see the untracking section. Said on stderr, so the line on
  # stdout stays the one thing to copy.
  {
    echo "git-guard-prepare: no pathspec in this command — it commits the whole index. Untracked"
    echo "                   with \`git rm --cached\` and still on disk, so a pathspec would put them back:"
    for p in "${untracked[@]}"; do echo "                     $p"; done
    echo "                   The index holds only this commit's paths now; if anything else is staged"
    echo "                   before the line runs, the next prep reports it as SWEPT IN."
  } >&2
  printf 'git commit -F %s\n' "$msg_q"
elif [ ${#paths[@]} -gt "$PATHSPEC_INLINE_MAX" ]; then
  # Long list: hand git a NUL-separated file instead of an unreadable line.
  # --pathspec-from-file requires git >= 2.25.
  printf "git commit -F %s --pathspec-from-file=%s --pathspec-file-nul\n" \
    "$msg_q" "$(shell_quote "$paths_file")"
else
  out="git commit -F $msg_q --"
  for p in "${paths[@]}"; do
    out="$out $(shell_quote "$p")"
  done
  printf '%s\n' "$out"
fi
