#!/bin/bash
# Local pre-commit hook. Activated by:
#     git config core.hooksPath .githooks
#
# Runs seven independent gates. Each fails fast — failure in any gate blocks
# the commit:
#   1. lib-sync       — every lib file carried by two or more plugins must stay
#                       byte-identical (caught by scripts/check-lib-sync.sh)
#   2. version-bump   — staged plugin file change requires bump in
#                       plugins/X/.claude-plugin/plugin.json; also asserts
#                       marketplace.json ↔ plugin.json parity unconditionally
#                       (caught by scripts/check-version-bump.sh)
#   3. skill-paths    — plugins/*/skills/**/SKILL.md and plugins/*/templates/*.md
#                       must use ${CLAUDE_PLUGIN_ROOT}, not dev-tree paths
#                       (caught by scripts/check-skill-paths.sh)
#   4. crystal        — workitems under docs/tasks/ with frontmatter status:done
#                       must have zero `- [ ]` checkboxes (crystal-cut DL #4)
#                       (caught by scripts/check-crystal-completion.sh)
#   5. crystal-canon  — a staged workitem must match the canonical shape
#                       derived from templates/workitem-template.md
#                       (caught by plugins/vdm/scripts/crystal-lint.sh --staged)
#   6. gate red-tests — changing a gate re-runs tests/gates.test.sh, which
#                       breaks each invariant on purpose and asserts the gate
#                       goes red, plus tests/gates-harness-isolation.test.sh,
#                       which asserts that no test harness writes into the
#                       commit that is running it. Conditional (~15s) — fires
#                       only when a gate or a harness is staged. The isolation
#                       half alone (~2s) also fires on ANY staged test file,
#                       because its subject is every test file.
#   7. hook fail-closed — changing anything under any plugin's scripts/, lib/
#                       or hooks/ re-runs every suite that exercises a blocking
#                       hook: tests/hook-fail-closed.test.sh (strips python3
#                       from PATH; the hook must block an in-scope call and
#                       stay silent on an out-of-scope one),
#                       tests/symlink-scope.test.sh (both engines must agree on
#                       what is in scope when the project is reached through a
#                       symlink), and the two vdm-comms suites, whose
#                       fail-closed cases live with the rest of that plugin's
#                       red tests. Conditional (~18s).

set -eu

staged=$(git diff --cached --name-only)

# Gate 1 — lib-sync: only relevant when a lib/ is staged. ANY plugin's — a
# trigger that enumerates plugins stops firing the day one is added, and the
# silence looks exactly like a clean run.
if printf '%s\n' "$staged" | grep -qE '^plugins/[^/]+/lib/'; then
  scripts/check-lib-sync.sh
fi

# Gate 2 — version-bump. Unconditional: the script itself decides what applies.
# The bump check is internally conditional (it only looks at plugins with staged
# files), while the marketplace ↔ plugin.json parity check must run on every
# commit — committed drift has to stay visible even when nobody is touching the
# manifests.
scripts/check-version-bump.sh

# Gate 3 — skill-paths: invariant must hold on every commit, regardless of
# what's staged. Fast (single grep per file).
scripts/check-skill-paths.sh

# Gate 4 — crystal: defense-in-depth backup to the crystal-completion-guard
# PreToolUse hook. Catches IDE-direct edits that flip status:done without
# clearing `- [ ]` items. Only fires when something is staged under
# docs/tasks/ — otherwise no-op.
scripts/check-crystal-completion.sh

# Gate 5 — crystal-canon: the second enforcement surface for the workitem canon.
# The PostToolUse hook only sees writes made THROUGH the assistant; an edit made
# directly in an IDE reaches the commit untouched, and in a harness without
# PostToolUse the hook never runs at all. This is the same defense-in-depth
# split as gate 4.
#
# It lives in the plugin rather than in scripts/check-*.sh because the canon is
# a FILE (the template), not a rule that can be restated here — restating it
# would create the second copy of the canon that deriving it exists to prevent.
plugins/vdm/scripts/crystal-lint.sh --staged

# Gate 6 — the gates' own red tests. A gate does not exist until you have
# watched it FAIL: green on a clean tree proves nothing, since `exit 0` is also
# green. The orphan audit shipped BLIND (`--` before grep's flags turned every
# --exclude into a filename) and passed every run for months — see
# docs/llm/soft-guidance-vs-deterministic-gates.md → "The orphan gate that never
# ran".
#
# Conditional, because the harness clones the repo and costs ~15s: it fires only
# when a gate script or the harness itself is staged. That is exactly when the
# cost is earned — you cannot change a gate without re-proving it still goes red.
if printf '%s\n' "$staged" | grep -qE '^(scripts/check-.*\.sh|plugins/vdm/scripts/(check-doc-orphans|crystal-lint)\.(sh|py)|tests/gates(-harness-isolation)?\.test\.sh|\.githooks/pre-commit)$'; then
  echo "gates: a gate changed — re-running its red tests (~15s)…"
  bash tests/gates.test.sh
  # The harness runs inside THIS commit. Prove it is not writing into it:
  # git exports GIT_INDEX_FILE to hooks, and for a pathspec commit that names
  # the temporary index holding the tree about to be committed. On 2026-09-04
  # the harness's `git add -A` (run in a clone deliberately built without
  # tests/) followed that variable home and dropped eight test files from
  # commit 7d80c73. Cheap — the probe runs the harness setup only.
  bash tests/gates-harness-isolation.test.sh
fi

# Same subject, wider trigger. The isolation harness asserts something about
# EVERY test file — that it scrubs the git session it may be running inside —
# so it has to re-run when a test file is added or edited, not only when a gate
# is. This is the trigger that was missing on 2026-09-22: gate 7 was widened to
# run two more suites, neither of them scrubbed, and the first `git add -A` in
# a fixture replaced 158 index entries of the pending commit with 9 fixture
# paths. Nothing about those suites had changed — only who invoked them. Cheap
# (~2s): the probe runs a harness setup, not a full suite.
if printf '%s\n' "$staged" | grep -qE '^tests/.*\.test\.sh$' &&
   ! printf '%s\n' "$staged" | grep -qE '^tests/gates(-harness-isolation)?\.test\.sh$'; then
  echo "gates: a test harness changed — re-checking git-session isolation (~2s)…"
  bash tests/gates-harness-isolation.test.sh
fi

# Gate 7 — the user-time hooks' fail-closed red tests. Same principle as gate 6,
# different subject: gate 6 covers the gates OF THIS REPO, this one covers the
# BLOCKING HOOKS THE PLUGINS SHIP. It builds symlink PATH farms without python3
# (and with a python3 that crashes) and asserts each hook blocks an in-scope
# call while staying silent on an out-of-scope one.
#
# Both directions are the gate. "Blocks when it cannot check" without "silent
# when it is not our call" is a hook that blocks everything on a machine
# without python3 — which gets the plugin uninstalled, i.e. the same as not
# existing. ~5s, so it is conditional on touching a hook or the shared helper.
#
# The trigger names no plugin and no script, for the reason gate 1 states and
# this gate then demonstrated: it used to enumerate `vdm|vdm-git` and the four
# scripts they carried, so the day a third plugin arrived with three blocking
# hooks of its own, the gate went on passing without covering any of them — and
# that silence is indistinguishable from a clean run. Breadth costs a few
# seconds on a plugin edit; the enumeration cost coverage without saying so.
if printf '%s\n' "$staged" | grep -qE '^(plugins/[^/]+/(scripts|lib|hooks)/|tests/(hook-fail-closed|symlink-scope|comms|comms-pending)\.test\.sh$)'; then
  echo "gates: a plugin hook changed — re-running the blocking hooks' red tests (~18s)…"
  bash tests/hook-fail-closed.test.sh
  # Same subject, second question: a hook that CAN run still has to agree with
  # its sibling on which files it is responsible for. Both engines, one fixture
  # reached through a symlink — the shape that silently took files out of scope.
  bash tests/symlink-scope.test.sh
  # vdm-comms keeps its fail-closed cases inside its own suites, next to the
  # contract tests they share a fixture with.
  bash tests/comms.test.sh
  bash tests/comms-pending.test.sh
fi
