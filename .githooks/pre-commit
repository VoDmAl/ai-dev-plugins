#!/bin/bash
# Local pre-commit hook. Activated by:
#     git config core.hooksPath .githooks
#
# Runs eleven independent gates. Each fails fast — failure in any gate blocks
# the commit.
#
# The timings below are rough figures for an idle machine. Under load they
# multiply: at load 40–70 on 8 cores a process launch costs ~13 ms instead of
# ~1 ms. They are claims, not measurements, and one of them went stale without a
# sound: gate 3's work grew with files × docs, and by 2026-09-25 one run started
# ~2100 processes. Where cost matters it is pinned by a launch count, which holds
# on any machine (tests/gates.test.sh → "gate cost").
#
#   1. lib-sync       — every lib file carried by two or more plugins must stay
#                       byte-identical (caught by scripts/check-lib-sync.sh)
#   2. version-bump   — staged plugin file change requires bump in
#                       plugins/X/.claude-plugin/plugin.json; also asserts
#                       marketplace.json ↔ plugin.json parity unconditionally
#                       (caught by scripts/check-version-bump.sh)
#   3. skill-paths    — plugins/*/skills/**/SKILL.md and plugins/*/templates/*.md
#                       must use ${CLAUDE_PLUGIN_ROOT}, not dev-tree paths
#                       (caught by scripts/check-skill-paths.sh)
#   4. crystal        — workitems under docs/tasks/ with frontmatter status:done
#                       must have zero `- [ ]` checkboxes (crystal-cut DL #4)
#                       (caught by scripts/check-crystal-completion.sh)
#   5. crystal-canon  — a staged workitem must match the canonical shape
#                       derived from templates/workitem-template.md
#                       (caught by plugins/vdm/scripts/crystal-lint.sh --staged)
#   6. gate red-tests — changing a gate re-runs tests/gates.test.sh, which
#                       breaks each invariant on purpose and asserts the gate
#                       goes red, plus tests/gates-harness-isolation.test.sh,
#                       which asserts that no test harness writes into the
#                       commit that is running it. Conditional (~15s) — fires
#                       only when a gate or a harness is staged. The isolation
#                       half alone (~2s) also fires on ANY staged test file,
#                       because its subject is every test file — and so does
#                       tests/harness-asserts.test.sh (~1s), which runs every
#                       suite's negative helper against an empty haystack and
#                       requires it to fail there.
#   7. hook fail-closed — changing anything under any plugin's scripts/, lib/
#                       or hooks/ re-runs every suite that exercises a blocking
#                       hook: tests/hook-fail-closed.test.sh (strips python3
#                       from PATH; the hook must block an in-scope call and
#                       stay silent on an out-of-scope one),
#                       tests/symlink-scope.test.sh (both engines must agree on
#                       what is in scope when the project is reached through a
#                       symlink), and the two vdm-comms suites, whose
#                       fail-closed cases live with the rest of that plugin's
#                       red tests, plus tests/reminder-throttle.test.sh (the
#                       shared reminder window, five hooks across two plugins)
#                       and tests/reminders-dispatch.test.sh (the one section
#                       the vdm reminders are composed into), plus
#                       tests/shared-rules.test.sh (the cross-project rules
#                       layer loaded at session start), plus
#                       tests/hook-commands.test.sh (every hooks.json command
#                       run through `/bin/sh -c` from a plugin root with a
#                       space in it), plus the suites of the two PostToolUse
#                       write checks: tests/crystal-lint.test.sh and
#                       tests/shell-syntax-check.test.sh. Conditional (~40s).
#   8. helper red-tests — changing a shipped helper under any plugin's bin/
#                       re-runs tests/<helper>.test.sh, and refuses a helper
#                       that has none. Conditional (~10s per helper).
#   9. snippet red-tests — changing any plugin's skills/ re-runs
#                       tests/githook-snippets.test.sh: the git-hook blocks a
#                       SKILL hands to a user's own pre-commit are read out of
#                       the SKILL and run against fake installs. Conditional
#                       (~5s).
#  10. shell-syntax   — every staged shell file must parse under the
#                       interpreter it will meet (its shebang's; for bash also
#                       the PATH one). Reads the staged blob
#                       (caught by plugins/vdm/scripts/shell-syntax-check.sh
#                       --staged). Unconditional; one `-n` per staged script.
#  11. owned suites   — a suite is named after what it tests: every staged file
#                       under a plugin's scripts/, lib/ or bin/ runs the
#                       tests/<name>.test.sh it is named after (scripts/
#                       suites-for.sh), and tests/suite-wiring.test.sh proves on
#                       every commit (~1s) that no suite is left without a
#                       trigger. Each suite runs at most once per commit, however
#                       many gates name it.
#  12. git-path-lists — every path list a script reads from git is read with -z
#                       and turned back into lines in the C locale
#                       (tests/git-path-lists.test.sh). Unconditional; one awk
#                       pass over the scripts.

set -eu

# -z, and `tr` in the C locale: in line form git quotes a path holding any byte
# outside ASCII, and a quoted path matches none of the triggers below; raw, a
# name that is not UTF-8 makes macOS `tr` stop in a UTF-8 locale (Sidetrack #9,
# docs/tasks/crystal-wake/workitem.md).
staged=$(git diff --cached --name-only -z | LC_ALL=C tr '\0' '\n')

# Every suite runs at most once per commit, whichever gate asks for it first —
# gate 11 below can name a suite that gate 7 has already run.
suites_ran=" "
suite_ran() { case "$suites_ran" in *" $1 "*) return 0 ;; esac; return 1; }
run_suite() {
  suite_ran "$1" && return 0
  suites_ran="$suites_ran$1 "
  bash "tests/$1.test.sh"
}
# Same, for a suite that runs on EVERY commit: one line when it passes, its
# full report only when it does not.
run_suite_quiet() {
  local out
  suite_ran "$1" && return 0
  suites_ran="$suites_ran$1 "
  if ! out=$(bash "tests/$1.test.sh" 2>&1); then
    printf '%s\n' "$out" >&2
    return 1
  fi
  printf '%s\n' "$out" | tail -n 1
}

# Gate 1 — lib-sync: only relevant when a lib/ is staged. ANY plugin's — a
# trigger that enumerates plugins stops firing the day one is added, and the
# silence looks exactly like a clean run.
if printf '%s\n' "$staged" | grep -qE '^plugins/[^/]+/lib/'; then
  scripts/check-lib-sync.sh
fi

# Gate 2 — version-bump. Unconditional: the script itself decides what applies.
# The bump check is internally conditional (it only looks at plugins with staged
# files), while the marketplace ↔ plugin.json parity check must run on every
# commit — committed drift has to stay visible even when nobody is touching the
# manifests.
scripts/check-version-bump.sh

# Gate 3 — skill-paths: invariant must hold on every commit, regardless of
# what's staged. Fast (single grep per file).
scripts/check-skill-paths.sh

# Gate 4 — crystal: defense-in-depth backup to the crystal-completion-guard
# PreToolUse hook. Catches IDE-direct edits that flip status:done without
# clearing `- [ ]` items. Only fires when something is staged under
# docs/tasks/ — otherwise no-op.
scripts/check-crystal-completion.sh

# Gate 5 — crystal-canon: the second enforcement surface for the workitem canon.
# The PostToolUse hook only sees writes made THROUGH the assistant; an edit made
# directly in an IDE reaches the commit untouched, and in a harness without
# PostToolUse the hook never runs at all. This is the same defense-in-depth
# split as gate 4.
#
# It lives in the plugin rather than in scripts/check-*.sh because the canon is
# a FILE (the template), not a rule that can be restated here — restating it
# would create the second copy of the canon that deriving it exists to prevent.
plugins/vdm/scripts/crystal-lint.sh --staged

# Gate 6 — the gates' own red tests. A gate does not exist until you have
# watched it FAIL: green on a clean tree proves nothing, since `exit 0` is also
# green. The orphan audit shipped BLIND (`--` before grep's flags turned every
# --exclude into a filename) and passed every run for months — see
# docs/llm/soft-guidance-vs-deterministic-gates.md → "The orphan gate that never
# ran".
#
# Conditional, because the harness clones the repo and costs ~15s: it fires only
# when a gate script or the harness itself is staged. That is exactly when the
# cost is earned — you cannot change a gate without re-proving it still goes red.
if printf '%s\n' "$staged" | grep -qE '^(scripts/check-.*\.sh|plugins/vdm/scripts/(check-doc-orphans|crystal-lint|shell-syntax-check)\.(sh|py)|tests/gates(-harness-isolation)?\.test\.sh|\.githooks/pre-commit)$'; then
  echo "gates: a gate changed — re-running its red tests (~15s)…"
  run_suite gates
  # The harness runs inside THIS commit. Prove it is not writing into it:
  # git exports GIT_INDEX_FILE to hooks, and for a pathspec commit that names
  # the temporary index holding the tree about to be committed. On 2026-09-04
  # the harness's `git add -A` (run in a clone deliberately built without
  # tests/) followed that variable home and dropped eight test files from
  # commit 7d80c73. Cheap — the probe runs the harness setup only.
  run_suite gates-harness-isolation
fi

# Same subject, wider trigger. The isolation harness asserts something about
# EVERY test file — that it scrubs the git session it may be running inside —
# so it has to re-run when a test file is added or edited, not only when a gate
# is. This is the trigger that was missing on 2026-09-22: gate 7 was widened to
# run two more suites, neither of them scrubbed, and the first `git add -A` in
# a fixture replaced 158 index entries of the pending commit with 9 fixture
# paths. Nothing about those suites had changed — only who invoked them. Cheap
# (~2s): the probe runs a harness setup, not a full suite.
if ! suite_ran gates-harness-isolation &&
   printf '%s\n' "$staged" | grep -qE '^tests/.*\.test\.sh$'; then
  echo "gates: a test harness changed — re-checking git-session isolation (~2s)…"
  run_suite gates-harness-isolation
fi

# Same trigger, second property of every harness: its negative assertion must
# fail on an empty haystack. "Does not mention X" is true of nothing, so a
# check written against an output that came back empty passes whatever the
# code did. On 2026-09-25 one such check stayed green over the defect it was
# written for. Runs each suite's helper, not a grep of its text (~1s).
if printf '%s\n' "$staged" | grep -qE '^tests/.*\.sh$'; then
  echo "gates: a test harness changed — negative assertions must fail on nothing (~1s)…"
  run_suite harness-asserts
fi

# Gate 7 — the user-time hooks' fail-closed red tests. Same principle as gate 6,
# different subject: gate 6 covers the gates OF THIS REPO, this one covers the
# BLOCKING HOOKS THE PLUGINS SHIP. It builds symlink PATH farms without python3
# (and with a python3 that crashes) and asserts each hook blocks an in-scope
# call while staying silent on an out-of-scope one.
#
# Both directions are the gate. "Blocks when it cannot check" without "silent
# when it is not our call" is a hook that blocks everything on a machine
# without python3 — which gets the plugin uninstalled, i.e. the same as not
# existing. ~5s, so it is conditional on touching a hook or the shared helper.
#
# The trigger names no plugin and no script, for the reason gate 1 states and
# this gate then demonstrated: it used to enumerate `vdm|vdm-git` and the four
# scripts they carried, so the day a third plugin arrived with three blocking
# hooks of its own, the gate went on passing without covering any of them — and
# that silence is indistinguishable from a clean run. Breadth costs a few
# seconds on a plugin edit; the enumeration cost coverage without saying so.
if printf '%s\n' "$staged" | grep -qE '^(plugins/[^/]+/(scripts|lib|hooks)/|tests/(hook-fail-closed|symlink-scope|comms|comms-pending|reminder-throttle|reminders-dispatch|shared-rules|hook-commands|crystal-lint|shell-syntax-check)\.test\.sh$)'; then
  echo "gates: a plugin hook changed — re-running the shipped hooks' red tests (~40s)…"
  run_suite hook-fail-closed
  # Same subject, second question: a hook that CAN run still has to agree with
  # its sibling on which files it is responsible for. Both engines, one fixture
  # reached through a symlink — the shape that silently took files out of scope.
  run_suite symlink-scope
  # vdm-comms keeps its fail-closed cases inside its own suites, next to the
  # contract tests they share a fixture with.
  run_suite comms
  run_suite comms-pending
  # The reminder hooks are shipped hooks too. They do not block, so they are not
  # in the fail-closed suites above — but their window is the mechanism that
  # decides whether a user reads them at all, and it is shared by five hooks
  # across two plugins through a mirrored lib.
  run_suite reminder-throttle
  run_suite reminders-dispatch
  # The cross-project rules layer is a shipped SessionStart hook: it must reach
  # a session in any directory, say so when it cannot load, and never cut a
  # letter in half at its size ceiling.
  run_suite shared-rules
  # Every suite above runs a script directly, which bypasses the one parse that
  # decides whether a hook starts at all: the harness hands the command STRING
  # to `/bin/sh -c`. Unquoted, a plugin root with a space in it split there and
  # every hook exited 127 — the blocking ones silently open (echelon,
  # 2026-09-25). This runs the strings themselves.
  run_suite hook-commands
  # The two PostToolUse write checks, whose suites no gate ran until vdm 2.36.0:
  # crystal-lint's (the canon, and since then the sidetrack a change leaves
  # without a checkbox) and the shell parse check's.
  run_suite crystal-lint
  run_suite shell-syntax-check
fi

# Gate 8 — the shipped helpers' red tests. `plugins/*/bin/` is put on the
# assistant's PATH in every user project, and until 2026-09-24 nothing re-ran a
# helper's suite: gate 7 is keyed to hooks, and `bin/` is not a hook. Found while
# changing git-guard-prepare, whose suite ran only when somebody remembered to
# run it.
#
# Keyed by name, not by a list, for gate 7's reason: `bin/<name>` owns
# `tests/<name>.test.sh`. A staged helper without one is refused — an
# enumeration would go quiet on the first helper nobody added to it. A deleted
# helper, or a suite that belongs to no helper, is not this gate's business.
for h in $(printf '%s\n' "$staged" \
             | sed -nE -e 's#^plugins/[^/]+/bin/([^/]+)$#\1#p' \
                       -e 's#^tests/([^/]+)\.test\.sh$#\1#p' \
             | sort -u); do
  compgen -G "plugins/*/bin/$h" >/dev/null || continue
  if [ ! -f "tests/$h.test.sh" ]; then
    echo "gates: shipped helper '$h' has no red-test suite — expected tests/$h.test.sh" >&2
    exit 1
  fi
  echo "gates: shipped helper '$h' changed — re-running its red tests (~10s)…"
  run_suite "$h"
done

# Gate 9 — the snippets a SKILL hands to a user's shell. They run outside the
# harness, in the user's own `.githooks/pre-commit`, where nothing of this suite
# looks at them again — and they find the plugin's install path by themselves.
# Until vdm-git 2.15.2 that finding was a glob taking the first clone by name;
# on the machine this suite is developed on it hit the live one of two clones by
# alphabetical luck (2026-09-25). The suite reads the blocks out of the SKILL, so
# what it runs is what a user pastes. Keyed to any plugin's skills/, not to the
# one SKILL that carries snippets today: at ~5s there is nothing to save by
# guessing, and a list would go quiet on the first new snippet.
if printf '%s\n' "$staged" | grep -qE '^(plugins/[^/]+/skills/|tests/githook-snippets\.test\.sh$)'; then
  echo "gates: a SKILL changed — re-running the git-hook snippets' red tests (~5s)…"
  run_suite githook-snippets
fi

# Gate 10 — every staged shell file parses under the interpreter it will meet.
# The PostToolUse check catches the assistant's writes the moment they land;
# this is the surface for everything else — an IDE edit, a patch applied by
# hand. The incident behind both (2026-09-25): a bare `case` pattern inside
# `$( )` that bash 3.2, the stock /bin/bash on macOS, cannot parse and bash 4+
# can — so it looked fine everywhere except where it runs. Unconditional: the
# script itself picks the staged shell files, and costs one `-n` per file.
bash plugins/vdm/scripts/shell-syntax-check.sh --staged

# Gate 11 — every suite runs when what it is named after changes, and none is
# left without a trigger. Until 2026-09-25 nine of the twenty-one suites under
# tests/ were run by no gate — crystal-lint's, crystal-path's, intercom's and
# distill-scan's among them: complete, with red cases, and green only for
# whoever remembered to run them. A list would go quiet on the next suite nobody
# adds to it, so this is a rule — a suite is named after its subject — and the
# rule lives once, in scripts/suites-for.sh. tests/suite-wiring.test.sh calls
# the same rule to prove that every suite is reachable by it or by a run_suite
# line above. It runs on every commit because what it guards breaks from either
# side: a new suite, or a gate line taken away.
run_suite_quiet suite-wiring
for s in $(printf '%s\n' "$staged" | bash scripts/suites-for.sh); do
  if ! suite_ran "$s"; then
    echo "gates: tests/$s.test.sh owns a staged file — running it…"
    run_suite "$s"
  fi
done

# Gate 12 — every path list read from git is read with -z and turned back into
# lines in the C locale. The same defect was fixed three times as if new: in line
# form git quotes a path holding any byte outside ASCII, and the quoted form is no
# path — two gates let a Cyrillic workitem through unchecked. Raw, one name that
# is not UTF-8 makes macOS `tr` stop in a UTF-8 locale (Sidetrack #9,
# docs/tasks/crystal-wake/workitem.md). One awk pass over the scripts; every
# commit, because a new reader can arrive in any of them.
run_suite_quiet git-path-lists
